# Google Gemini API — single shared key, server-only.
# Get one for free at https://aistudio.google.com/apikey (no credit card required).
# NEVER prefix this with NEXT_PUBLIC_ — it must never reach the browser.
GEMINI_API_KEY=

# Optional: override the default model (see lib/ai/gemini.ts for the fallback).
# GEMINI_MODEL=gemini-flash-lite-latest
